{
  "name": "exchange-hub",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n f,b \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:frontend": "cd frontend && vite",
    "dev:backend": "bun run --cwd backend dev",
    "build": "bun run build:frontend && bun run build:backend",
    "build:frontend": "bun run --cwd frontend build",
    "build:backend": "bun run --cwd backend build",
    "lint": "bun run --cwd frontend lint && bun run --cwd backend lint",
    "test": "bun run --cwd frontend test",
    "db:studio": "bun run --cwd backend db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.1.38"
}
