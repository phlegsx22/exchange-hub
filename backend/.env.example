# Required. Postgres connection URL (e.g. Supabase: Project Settings → Database → Connection string URI).
# If the password contains special characters, URL-encode them (e.g. # → %23, & → %26).
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Optional. Port for the API server. Default: 3000
API_PORT=3000

# Required. Used for email links (e.g. verify-email) and CORS allowlist.
FRONTEND_URL=https://annex-ebank.com

# Optional. JWT signing secret. Change in production.
JWT_SECRET=change-me-in-production

# Required for admin registration endpoint.
# Keep this secret ONLY on the server. You will type it into /admin/register when creating an admin.
ADMIN_BOOTSTRAP_SECRET=change-me-long-random

# Optional. Cloudinary for KYC media uploads (recommended).
# The frontend uploads directly to Cloudinary using a signature from the backend.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional. Resend for transactional and admin notification emails.
RESEND_API_KEY=re_...
VERIFY_FROM_EMAIL=verify@annex-ebank.com
NOTIFY_FROM_EMAIL=no-reply@annex-ebank.com

# Optional. Comma-separated admin emails to receive operational alerts.
# Example: ADMIN_NOTIFICATION_EMAILS=admin@annex-ebank.com,ops@annex-ebank.com
ADMIN_NOTIFICATION_EMAILS=

# Optional. Free/public RPC endpoints for on-chain polling (MVP).
# If not set, that chain is skipped by the deposit poller.
RPC_ETHEREUM_URL=
RPC_BSC_URL=
RPC_BASE_URL=
RPC_ARBITRUM_URL=
# Optional for BTC polling (default: blockstream public API)
BTC_API_BASE=https://blockstream.info/api
# Optional for TRON/TRC polling (default: public TronGrid endpoint)
TRON_GRID_API_BASE=https://api.trongrid.io
# Optional API key for higher TronGrid rate limits
TRON_PRO_API_KEY=

# Optional. Deposit poll interval in milliseconds.
CHAIN_POLL_INTERVAL_MS=60000
