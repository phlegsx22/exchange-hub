# Required. Postgres connection URL (e.g. Supabase: Project Settings → Database → Connection string URI).
# If the password contains special characters, URL-encode them (e.g. # → %23, & → %26).
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Optional. Port for the API server. Default: 3000
API_PORT=3000

# Optional. Used for email links (e.g. verify-email). Default: http://localhost:5173
FRONTEND_URL=http://localhost:4173

# Optional. JWT signing secret. Change in production.
JWT_SECRET=change-me-in-production

# Optional. Cloudinary for KYC media uploads (recommended).
# The frontend uploads directly to Cloudinary using a signature from the backend.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
